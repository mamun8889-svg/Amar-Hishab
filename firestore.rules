rules_version = '2';
// আমার হিসাব — Firestore নিয়ম। Firebase Console → Firestore Database → Rules-এ পুরোটা পেস্ট করে Publish করুন।
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && me().active == true; }
    function isSuper() { return active() && me().role == 'super'; }
    function fundDoc(fid) { return get(/databases/$(database)/documents/funds/$(fid)).data; }
    function fundAfter(fid) { return getAfter(/databases/$(database)/documents/funds/$(fid)).data; }

    // প্রথম সুপার এডমিন সেটআপ: যতক্ষণ config/super নেই, প্রথম ব্যক্তি নিজেকে সুপার বানাতে পারে
    match /config/super {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/config/super);
    }
    match /config/app {
      allow get: if true;
      allow create: if signedIn() && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super'
                    && !exists(/databases/$(database)/documents/config/app);
      allow update: if isSuper();
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isSuper());
      allow list: if isSuper();
      allow create: if signedIn() && (
          isSuper()
          || (request.auth.uid == uid && request.resource.data.role == 'user' && request.resource.data.active == true
              && get(/databases/$(database)/documents/config/app).data.signup == true)
          || (request.auth.uid == uid && request.resource.data.role == 'super'
              && !exists(/databases/$(database)/documents/config/super)
              && getAfter(/databases/$(database)/documents/config/super).data.uid == uid));
      allow update: if isSuper()
          || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isSuper();
      // ব্যক্তিগত খাতা, সেটিংস ও ব্যাকআপ — শুধু মালিক (এবং সুপার এডমিন)
      match /{document=**} {
        allow read, write: if (request.auth.uid == uid && active()) || isSuper();
      }
    }

    // আইডি → নাম (ফান্ডে সদস্য যোগ করার জন্য)
    match /usernames/{u} {
      allow read: if signedIn();
      allow create: if signedIn() && (request.resource.data.uid == request.auth.uid || isSuper());
      allow update, delete: if isSuper();
    }

    match /funds/{fid} {
      allow read: if isSuper() || (active() && request.auth.uid in resource.data.memberIds);
      allow create: if isSuper() || (active() && request.resource.data.createdBy == request.auth.uid
                       && request.auth.uid in request.resource.data.memberIds);
      allow update: if isSuper() || (active() && resource.data.members[request.auth.uid].r == 'editor');
      allow delete: if isSuper() || (active() && resource.data.createdBy == request.auth.uid);
      match /{sub}/{id} {
        allow read: if isSuper() || (active() && request.auth.uid in fundDoc(fid).memberIds);
        allow write: if isSuper() || (active() && fundAfter(fid).members[request.auth.uid].r == 'editor');
      }
    }
  }
}
